"""Bounded 13-CNOT V4 search with wholesale pair-block suffix rewiring.

Keep the exact14 six-CNOT prefix, delete one CNOT from its eight-CNOT
matchgate suffix, then replace three complete two-CNOT block edge pairs.
Arbitrary SU(2) layers are fitted after every fixed local chunk. The loss is
the label-free off-diagonal Frobenius norm of U V4 U-dagger, divided by 16.
This experiment is a numerical screen, not an exactness or lower-bound proof.
"""

import argparse
import json
from pathlib import Path

import numpy as np
import torch
from scipy.optimize import minimize

from check_circuit import evaluate, right_shift
from delete14_search import axis_rotation, axis_to_u3, fixed_matrix, kron_gate


ROOT = Path(__file__).resolve().parent
BASE = ROOT / "topology14_exact_matchgate_rational.json"
# Each schedule specifies the deleted old CNOT index, then all four ordered
# suffix pair-block edges. Three whole pairs differ from the exact14 pattern
# (02, 13, 01, 23), which is outside prior one-edge reroute scans.
CASES = [
    (6, ((0, 2), (0, 1), (2, 3), (1, 3))),
    (8, ((0, 1), (1, 3), (0, 2), (1, 3))),
    (10, ((1, 3), (0, 1), (0, 1), (0, 2))),
]

torch.set_num_threads(1)
CDTYPE = torch.complex128
RDTYPE = torch.float64


def prepare(deleted, block_edges):
    source = json.loads(BASE.read_text())
    chunks, cxs = [[]], []
    old_index = -1
    for gate in source["gates"]:
        if gate["gate"] == "cx":
            old_index += 1
            if old_index == deleted:
                continue
            changed = dict(gate)
            if old_index >= 6:
                changed.update(control=block_edges[(old_index - 6) // 2][0],
                               target=block_edges[(old_index - 6) // 2][1])
            cxs.append(changed)
            chunks.append([])
        else:
            chunks[-1].append(gate)
    if old_index != 13 or len(cxs) != 13 or len(chunks) != 14:
        raise ValueError("expected 14-CNOT source and 13-CNOT result")
    fixed = []
    for chunk in chunks:
        matrix = np.eye(16, dtype=complex)
        for gate in chunk:
            matrix = fixed_matrix(gate) @ matrix
        fixed.append(torch.as_tensor(matrix, dtype=CDTYPE))
    cxm = [torch.as_tensor(fixed_matrix(g), dtype=CDTYPE) for g in cxs]
    return chunks, cxs, fixed, cxm


def fit(deleted, block_edges, seed, sigma, maxiter):
    chunks, cxs, fixed, cxm = prepare(deleted, block_edges)
    v = torch.as_tensor(right_shift(4), dtype=CDTYPE)
    rng = np.random.default_rng(seed)
    x0 = rng.normal(0, sigma, (14, 4, 3))

    def objective(flat):
        angles = torch.tensor(flat.reshape(14, 4, 3), dtype=RDTYPE,
                              requires_grad=True)
        u = torch.eye(16, dtype=CDTYPE)
        for slot in range(14):
            u = fixed[slot] @ u
            for qubit in range(4):
                u = kron_gate(axis_rotation(*angles[slot, qubit]), qubit) @ u
            if slot < 13:
                u = cxm[slot] @ u
        transformed = u @ v @ u.conj().T
        off = transformed - torch.diag(torch.diagonal(transformed))
        loss = (off.abs() ** 2).sum().real / 16
        grad = torch.autograd.grad(loss, angles)[0]
        return float(loss.detach()), grad.detach().numpy().ravel().copy()

    initial_loss = objective(x0.ravel())[0]
    opt = minimize(objective, x0.ravel(), method="L-BFGS-B", jac=True,
                   options={"maxiter": maxiter, "ftol": 1e-15,
                            "gtol": 1e-11, "maxls": 30})
    angles = opt.x.reshape(14, 4, 3)
    gates = []
    for slot, chunk in enumerate(chunks):
        gates.extend(chunk)
        for qubit in range(4):
            gates.append({"gate": "u3", "qubit": qubit,
                          **axis_to_u3(*angles[slot, qubit])})
        if slot < 13:
            gates.append(cxs[slot])
    candidate = {"n": 4, "gates": gates}
    checked = evaluate(candidate)
    record = {"deleted": deleted, "block_edges": block_edges,
              "seed": seed, "sigma": sigma, "maxiter": maxiter,
              "initial_loss": initial_loss, "loss": float(opt.fun),
              "nit": int(opt.nit), "nfev": int(opt.nfev),
              "optimizer_success": bool(opt.success),
              "optimizer_message": str(opt.message),
              "off_diagonal_error": checked["off_diagonal_error"],
              "eigenvalue_root_error": checked["eigenvalue_root_error"],
              "valid_diagonalizer": checked["valid_diagonalizer"]}
    return candidate, record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--maxiter", type=int, default=250)
    parser.add_argument("--seed", type=int, default=13570)
    parser.add_argument("--prefix", default="search13_multi_pair_block_rewire")
    args = parser.parse_args()
    results = []
    for case_index, (deleted, edges) in enumerate(CASES):
        for start, sigma in enumerate((0.04, 0.3)):
            seed = args.seed + 2 * case_index + start
            candidate, record = fit(deleted, edges, seed, sigma, args.maxiter)
            path = ROOT / f"{args.prefix}_case{case_index}_s{start}.json"
            path.write_text(json.dumps(candidate, indent=2) + "\n")
            record["candidate"] = path.name
            results.append(record)
            print(json.dumps(record, sort_keys=True), flush=True)
    summary = {"base": BASE.name, "cases": CASES, "results": results,
               "best": min(results, key=lambda r: r["loss"])}
    path = ROOT / f"{args.prefix}_result.json"
    path.write_text(json.dumps(summary, indent=2) + "\n")
    print(json.dumps({"result_file": path.name, "best": summary["best"]},
                     sort_keys=True), flush=True)


if __name__ == "__main__":
    main()
